# ---------------------------------------------------------------------------
# Static hosting (custom domain) — the only variable you actually need
# ---------------------------------------------------------------------------
# Off Apps Script there is no google.script.run, so the page reads the public
# spreadsheet directly. The ID is the part of its URL between /d/ and /edit.
VITE_PUBLIC_SHEET_ID=

# Which tab to read. Optional — defaults to Рейтинг, which is what we use.
# Note: an unknown tab name does NOT error; Google quietly returns the first
# sheet instead. The app checks the shape and fails loudly, but get it right.
VITE_PUBLIC_SHEET_TAB=Рейтинг

# ---------------------------------------------------------------------------
# Not needed
# ---------------------------------------------------------------------------
# Apps Script hosting: leave everything empty. The page is served by Apps
# Script and fetches through google.script.run — same-origin and already
# authenticated. That transport wins whenever it exists, so these are ignored.
#
# With nothing set at all, `npm run dev` runs on src/mock/leaderboard.json.

# Only for a web app deployed with "Anyone" access, which Workspace policy
# blocks today. The …/exec URL.
VITE_LEADERBOARD_URL=
